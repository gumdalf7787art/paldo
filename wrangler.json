{
	"main": ".open-next/worker.js",
	"name": "paldo-dog",
	"compatibility_date": "2026-06-21",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"services": [
		{
			"binding": "WORKER_SELF_REFERENCE",
			"service": "paldo-dog"
		}
	],
	"r2_buckets": [
		{
			"binding": "NEXT_INC_CACHE_R2_BUCKET",
			"bucket_name": "paldo-opennext-cache"
		},
		{
			"binding": "R2",
			"bucket_name": "paldo-r2"
		}
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "DB",
			"database_id": "049c3da8-77fa-45f4-8d18-8c22d2a73a53"
		}
	],
	"images": {
		"binding": "IMAGES"
	}
}